{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Data Practice Tool Datasets",
  "datasets": {
    "avengers": {
      "title": "Marvel Avengers Character Data",
      "source": "processed_avengers.csv",
      "description": "Track character deaths, resurrections, and appearances across Marvel comics",
      "preprocessing": "Cleaned from raw FiveThirtyEight data with standardized gender labels",
      "columns": {
        "name": {
          "type": "string",
          "description": "Full character name",
          "example": "Peter Parker"
        },
        "appearances": {
          "type": "integer",
          "description": "Total comic appearances",
          "example": 403
        },
        "gender": {
          "type": "category",
          "categories": ["Male", "Female", "Non-binary"],
          "description": "Character gender identity"
        },
        "death_count": {
          "type": "integer",
          "description": "Number of recorded deaths",
          "example": 3
        }
      },
      "colab_settings": {
        "encoding": "utf-8",
        "parse_dates": ["first_appearance"],
        "dtype": {
          "appearances": "int32",
          "death_count": "int8"
        }
      },
      "starter_exercises": [
        {
          "title": "Gender Analysis",
          "tasks": [
            "Plot gender distribution as a pie chart",
            "Calculate average deaths by gender"
          ],
          "hint": "Use df.groupby() and .plot()"
        },
        {
          "title": "Survival Analysis",
          "tasks": [
            "Find top 5 characters by death count",
            "Create a scatter plot of appearances vs deaths"
          ]
        }
      ],
      "tags": ["comics", "entertainment", "superheroes"],
      "difficulty": "beginner"
    },
    "majors": {
      "title": "College Majors & Salaries",
      "source": "https://raw.githubusercontent.com/your-repo/majors.csv",
      "description": "Post-graduation salary data by college major and demographic factors",
      "columns": {
        "major_code": {
          "type": "integer",
          "description": "IPEDS classification code"
        },
        "major": {
          "type": "string",
          "description": "Name of college major"
        },
        "median_salary": {
          "type": "float",
          "description": "Median early-career salary (USD)",
          "example": 45000.50
        }
      },
      "colab_settings": {
        "encoding": "latin-1",
        "na_values": ["NA", "PrivacySuppressed"]
      },
      "starter_exercises": [
        {
          "title": "Salary Explorer",
          "tasks": [
            "Find the 10 highest-paying majors",
            "Compare salaries between STEM vs humanities majors"
          ]
        }
      ],
      "tags": ["education", "economics"],
      "difficulty": "intermediate"
    },
    "lyrics": {
      "title": "Hip-Hop Political Lyrics",
      "source": "lyrics_processed.csv",
      "description": "Mentions of 2016 presidential candidates in hip-hop lyrics",
      "columns": {
        "artist": {
          "type": "string",
          "description": "Performer name"
        },
        "song": {
          "type": "string",
          "description": "Song title"
        },
        "candidate": {
          "type": "category",
          "categories": ["Clinton", "Trump", "Sanders"],
          "description": "Mentioned politician"
        }
      },
      "starter_exercises": [
        {
          "title": "Political Analysis",
          "tasks": [
            "Count mentions by candidate",
            "Find most frequently mentioned artist"
          ]
        }
      ],
      "tags": ["music", "politics"],
      "difficulty": "beginner"
    },
    "masculinity": {
      "title": "Masculinity Survey Results",
      "source": "masculinity_survey.csv",
      "description": "Responses from American men about modern masculinity",
      "columns": {
        "age": {
          "type": "integer",
          "description": "Respondent age",
          "range": [18, 99]
        },
        "response": {
          "type": "string",
          "description": "Open-ended survey response"
        },
        "sentiment": {
          "type": "float",
          "description": "Pre-calculated sentiment score (-1 to 1)",
          "example": 0.34
        }
      },
      "colab_settings": {
        "encoding": "utf-8",
        "converters": {
          "response": "str.strip"
        }
      },
      "starter_exercises": [
        {
          "title": "Sentiment Analysis",
          "tasks": [
            "Plot sentiment distribution by age group",
            "Find most common words in responses"
          ]
        }
      ],
      "tags": ["sociology", "gender"],
      "difficulty": "intermediate"
    }
  },
  "_metadata": {
    "version": "1.0.0",
    "created": "2023-11-15",
    "maintainer": "your-email@example.com",
    "update_instructions": "Add new datasets with matching CSV files and update this JSON"
  }
}